{
  // Site da Dra. Deyse Dhulle publicado como Worker com arquivos estáticos (Cloudflare)
  "name": "dra-deyse-dhulle",
  "compatibility_date": "2026-11-01",
  "main": "_worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Domínio oficial (a Cloudflare cria os registros e o certificado sozinha)
  "routes": [
    { "pattern": "www.dradeysedhulle.com.br", "custom_domain": true },
    { "pattern": "dradeysedhulle.com.br", "custom_domain": true }
  ]
}
